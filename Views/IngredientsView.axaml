<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewmodels="using:Client.ViewModels"
    xmlns:models="using:Client.Models"
    x:Class="Client.Views.IngredientsView"
    x:DataType="viewmodels:IngredientsViewModel">
<ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="20" Spacing="10">

        <TextBlock
            FontSize="24"
            Text="Råvaror"/>

        <TextBox PlaceholderText="Artikelnummer"
                 Text="{Binding ArticleNumber}" />

        <TextBox PlaceholderText="Namn"
                 Text="{Binding Name}" />

        <TextBox PlaceholderText="Pris per kg (ex. 12,50 eller 12.50)"
                 Text="{Binding PricePerKg}" />

        <TextBox PlaceholderText="Tillgängligt lager (kg) (ex. 100,50 eller 100.50)"
                 Text="{Binding StockQuantityKg}" />

        <ComboBox ItemsSource="{Binding Suppliers}" SelectedItem="{Binding SelectedSupplier}">

                    <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="models:Supplier">
                    <TextBlock Text="{Binding Name}" />
                    </DataTemplate>
                    </ComboBox.ItemTemplate>

        </ComboBox>

        <Button
    Content="Lägg till råvara"
    Command="{Binding AddIngredientCommand}" />

        <ListBox ItemsSource="{Binding Ingredients}">
            <ListBox.ItemTemplate>

                <DataTemplate x:DataType="models:Ingredients">

                    <StackPanel>
                        <TextBlock Text="{Binding Name}" />
                        <TextBlock Text="{Binding ArticleNumber}" />
                    </StackPanel>

                </DataTemplate>

            </ListBox.ItemTemplate>
        </ListBox>

    </StackPanel>
</ScrollViewer>
</UserControl>